		"@reduxjs/toolkit": "^2.11.2",
		"@stomp/stompjs": "^7.3.0",
		"axios": "^1.14.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"lucide-react": "^1.21.0",
		"next": "^16.2.4",
		"razorpay": "^2.9.6",
		"react": "^19.2.5",
		"react-day-picker": "^9.14.0",
		"react-dom": "^19.2.5",
