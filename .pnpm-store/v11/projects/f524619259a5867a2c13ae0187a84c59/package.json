{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build --turbopack",
		"start": "next start",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"check:all": "biome check . && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run tests/vitest/unit",
		"test:components": "vitest run tests/vitest/components",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"test:all": "pnpm run test && pnpm run test:e2e"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
