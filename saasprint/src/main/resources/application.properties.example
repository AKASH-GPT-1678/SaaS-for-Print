spring.application.name=saasprint

# Database
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/saasprint}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD}

# JWT signing key — must be at least 32 characters. Do not commit real values.
jwt.secret=${JWT_SECRET}

# Frontend origins for CORS and SockJS (comma-separated)
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:3000}
app.frontend-base-url=${FRONTEND_BASE_URL:http://localhost:3000}

# AWS S3 — set via environment, never commit real keys
aws.access.key=${AWS_ACCESS_KEY}
aws.secret.key=${AWS_SECRET_KEY}
aws.region=${AWS_REGION:eu-north-1}
aws.bucket.name=${AWS_BUCKET:saasprint}

spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=20MB
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# Optional Google OAuth (not wired yet)
# spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID}
# spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET}
# spring.security.oauth2.client.registration.google.scope=openid,profile,email
# spring.security.oauth2.client.registration.google.redirect-uri={baseUrl}/login/oauth2/code/google
